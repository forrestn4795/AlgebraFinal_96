Solve: x + 7 = 19

(link: "A. x = 12")[(goto: "LNG Day 2 Correct")]

(link: "B. x = 26")[(goto: "LNG Day 2 Wrong")]

(link: "C. x = 7")[(goto: "LNG Day 2 Wrong")]

(link: "D. x = 19")[(goto: "LNG Day 2 Wrong")]
]

