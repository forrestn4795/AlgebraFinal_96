:: Story Stylesheet [stylesheet]
tw-sidebar { display: none; }
tw-passage { max-width: 900px; margin: 0 auto; font-size: 1.1em; line-height: 1.45; }
tw-link, .enchantment-link { display: inline-block; padding: 0.55em 0.8em; margin: 0.25em 0.15em; border: 1px solid #bbb; border-radius: 10px; background: #f5f5f5; }
tw-link:hover, .enchantment-link:hover { background: #e9e9e9; }
body { background: #fbfaf7; }

